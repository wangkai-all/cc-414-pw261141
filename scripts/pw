#!/usr/bin/env python3
"""Path-bootstrap launcher so the CLI runs under `python -I` from anywhere.

`-I` (isolated mode) ignores PYTHONPATH and the current directory, which is
exactly the mode used when handling untrusted data files. This launcher
inserts the repository root explicitly, then hands off to the package CLI.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from pointwise.__main__ import main  # noqa: E402

if __name__ == "__main__":
    main()
